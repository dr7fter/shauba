{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "刷吧",
  "version": "1.8.8",
  "identifier": "com.shuaba.math",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "刷吧",
        "width": 1440,
        "height": 900,
        "minWidth": 840,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEOEM2QUYzOUQ1OThGMDUKUldRRmoxbWQ4MnFNUFZKVGRsTUdxYkVrZi84YzFIdEkzeUF6MDJJZ3NQMjRyMGJiWVkrYlhKTW4K",
      "endpoints": [
        "https://github.com/dr7fter/shauba/releases/latest/download/latest.json"
      ]
    }
  }
}

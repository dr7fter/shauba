.footer-actions { display: flex; align-items: center; gap: 8px; }.secondary-button.quiet { border-color: transparent; background: transparent; color: var(--muted); font-size: 11px; }.secondary-button.quiet:hover { color: var(--green-dark); background: #f2f6f3; }

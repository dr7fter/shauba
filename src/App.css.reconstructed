/* v0.3.0: keyboard-first training, skip, judgement, undo, multi-subject mastery, insights, backup */
kbd { padding: 1px 5px; border: 1px solid rgba(120,140,131,.45); border-bottom-width: 2px; border-radius: 4px; background: #f3f6f4; color: #586b62; font-family: ui-monospace,monospace; font-size: 10px; line-height: 1.4; }
button kbd { margin-left: 2px; opacity: .8; }

.review-actions { display: flex; align-items: center; gap: 8px; }
.review-actions .primary-button { flex: 1; }
.detail-answer, .detail-explanation { margin-top: 18px; padding: 12px 14px; border-left: 3px solid var(--green); background: #f3f8f4; }.detail-answer span, .detail-explanation span { display: block; margin-bottom: 6px; color: var(--green-dark); font-size: 10px; font-weight: 800; }.detail-explanation { border-left-color: var(--blue); background: var(--blue-soft); }.detail-explanation span { color: #2f627d; }.detail-option.correct { border-color: #4aa053 !important; background: #f0faf1 !important; }

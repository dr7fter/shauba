.treemap-board { min-height: 520px; display: flex; flex-wrap: wrap; gap: 7px; align-content: stretch; }.treemap-chapter { min-width: 250px; min-height: 238px; flex-basis: 31%; display: grid; grid-template-rows: 38px minmax(0,1fr); overflow: hidden; border: 1px solid var(--line); border-radius: 7px; background: #fff; }.treemap-chapter > header { padding: 0 11px; display: flex; align-items: center; justify-content: space-between; background: #edf2ee; color: #4d6156; }.treemap-chapter header b { font-size: 12px; }.treemap-chapter header span { color: var(--muted); font-size: 10px; }.treemap-cells { min-height: 0; padding: 4px; display: flex; flex-wrap: wrap; gap: 4px; align-content: stretch; }.treemap-cell { min-width: 54px; min-height: 58px; padding: 7px; border: 0; border-radius: 3px; display: flex; flex-direction: column; justify-content: space-between; text-align: left; cursor: pointer; overflow: hidden; transition: transform .14s ease,box-shadow .14s ease; }.treemap-cell:hover { z-index: 1; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(55,70,62,.14); }.treemap-cell b { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 10px; line-height: 1.35; }.treemap-cell span { color: inherit; opacity: .72; font-size: 9px; }.treemap-cell.unseen { background: #edf0ee; color: #7b8580; }.treemap-cell.insufficient { background: #ece8dc; color: #796b4e; }.treemap-cell.weak { background: #eadbd8; color: #795452; }.treemap-cell.steady { background: #dce6e7; color: #506b70; }.treemap-cell.strong { background: #d6e3da; color: #466052; }.mastery-selection { min-height: 70px; margin-top: 12px; padding: 10px 12px 10px 16px; display: grid; grid-template-columns: minmax(220px,1.5fr) repeat(4,minmax(80px,.5fr)) 34px; gap: 14px; align-items: center; border-left: 3px solid var(--green); background: #fff; box-shadow: 0 5px 18px rgba(55,70,62,.06); }.mastery-selection > div { min-width: 0; display: flex; flex-direction: column; }.mastery-selection span { color: var(--muted); font-size: 9px; }.mastery-selection b { margin-top: 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 12px; }


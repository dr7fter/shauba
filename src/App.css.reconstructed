.tile-progress { height: 6px; margin: 8px 0 12px; border-radius: 5px; overflow: hidden; background: rgba(92,113,104,.14); }.tile-progress i { display: block; min-width: 2px; height: 100%; border-radius: inherit; background: var(--green); }.mastery-tile.unseen .tile-progress i { min-width: 0; }

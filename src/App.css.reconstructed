
.inbox-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }.inbox-toolbar h2 { font-size: 20px; margin: 0 0 5px; }.inbox-toolbar p { margin: 0; color: var(--muted); font-size: 11px; }
